# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 실제 값은 절대 커밋하지 않는다. 이름만 담은 예시는 커밋한다.
.env*
!.env.example

# 오라클 지갑 — 접속 자격증명이므로 저장소에 올리지 않는다.
# 배포 시에는 이미지에 넣지 않고 실행 시 마운트한다.
/wallet/
cwallet.sso
ewallet.p12
ewallet.pem
tnsnames.ora
sqlnet.ora
ojdbc.properties

# typescript
*.tsbuildinfo
next-env.d.ts

# harness/results 는 의도적으로 커밋한다 (수치의 재현 근거).
# 여기에 추가하지 말 것 — AGENTS.md 하네스 규칙 참고.

# 편집기 백업 파일
*.bak
