# PickFlow 환경변수 예시
# 이 파일은 이름만 담는다. 실제 값은 .env.local 에 넣고 절대 커밋하지 않는다.
# 로컬 오라클 ↔ 오라클 클라우드 전환은 이 값들만 바꿔서 한다.

# --- 오라클 접속 (node-oracledb Thin 모드) ---
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=

# --- 오라클 클라우드 지갑 (Autonomous Database 접속 시에만) ---
# 지갑 파일은 이미지에 넣지 않고 실행 시 마운트한다 (P3 참고)
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=

# --- 커넥션 풀 (앱 시작 시 1회만 생성) ---
ORACLE_POOL_MIN=
ORACLE_POOL_MAX=

# --- 인증 (Auth.js Credentials) ---
AUTH_SECRET=
AUTH_URL=
